@model ApartmentManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div id="payment-live-banner" class="alert alert-info d-none mb-2" role="alert"></div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (User.Identity?.Name?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true)
    {
        <div class="alert alert-primary d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <strong>Step 1 — Committee setup:</strong> assign President, Vice President, Secretary,
                Joint Secretary, and Treasurer from your imported resident list. Only they can add residents.
            </div>
            <a asp-controller="Committee" asp-action="Index" class="btn btn-light text-primary fw-bold">
                Assign committee from import
            </a>
        </div>
    }

    @if (Model.ResidentPayments?.HasResidentProfile == true)
    {
        <partial name="_ResidentPaymentsCard" model="Model.ResidentPayments" />
    }
    else if (User.IsInRole("Admin"))
    {
        <div class="alert alert-light border mb-3">
            <i class="fas fa-info-circle me-1"></i>
            No flat linked to your admin account — society overview only.
            Link a flat on your resident profile if you also pay maintenance.
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Resident"))
    {
        <partial name="_DownloadExcelReport" />

        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalResidents</h3>
                        <p>Total Residents</p>
                    </div>
                    <div class="icon"><i class="fas fa-users"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@Model.TotalFlats</h3>
                        <p>Total Flats</p>
                    </div>
                    <div class="icon"><i class="fas fa-building"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.TotalOwners</h3>
                        <p>In-house Owners</p>
                    </div>
                    <div class="icon"><i class="fas fa-user-tie"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-teal" style="background-color:#17a2b8 !important;">
                    <div class="inner">
                        <h3>@Model.TotalTenants</h3>
                        <p>In-house Tenants</p>
                    </div>
                    <div class="icon"><i class="fas fa-user-friends"></i></div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>₹@Model.CurrentMonthCollection.ToString("N2")</h3>
                        <p>This month collected</p>
                    </div>
                    <div class="icon"><i class="fas fa-money-bill"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h3>₹@Model.TotalCollected.ToString("N2")</h3>
                        <p>Total collected (paid)</p>
                    </div>
                    <div class="icon"><i class="fas fa-coins"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>₹@Model.TotalExpenses.ToString("N2")</h3>
                        <p>Total Expenses</p>
                    </div>
                    <div class="icon"><i class="fas fa-wallet"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>₹@Model.BalanceAmount.ToString("N2")</h3>
                        <p>Balance Amount</p>
                    </div>
                    <div class="icon"><i class="fas fa-credit-card"></i></div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.PendingPayments</h3>
                        <p>Pending Payments</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                    <a href="/Payments" class="small-box-footer text-white">
                        Payment details <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }

    <partial name="_AssociationCommittee" model="Model.AssociationCommittee" />

    @if ((User.IsInRole("Admin") || User.IsInRole("Resident")) && Model.PendingMaintenanceList.Any())
    {
        <div class="card shadow mt-3">
            <div class="card-header bg-warning">
                <h3 class="card-title mb-0">Pending Maintenance Dues</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Flat</th>
                            <th>Month</th>
                            <th>Year</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PendingMaintenanceList)
                        {
                            <tr>
                                <td>@item.FlatNumber</td>
                                <td>@item.Month</td>
                                <td>@item.Year</td>
                                <td>₹@item.Amount.ToString("N2")</td>
                                <td><span class="badge bg-danger">Pending</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/payment-realtime.js"></script>
}
