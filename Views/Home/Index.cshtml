@model ApartmentManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (User.IsInRole("Resident") && Model.ResidentPayments != null)
    {
        <partial name="_ResidentPaymentsCard" model="Model.ResidentPayments" />
    }

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@Model.TotalResidents</h3>
                    <p>Total Residents</p>
                </div>
                <div class="icon"><i class="fas fa-users"></i></div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@Model.TotalFlats</h3>
                    <p>Total Flats</p>
                </div>
                <div class="icon"><i class="fas fa-building"></i></div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@Model.TotalOwners</h3>
                    <p>Owners</p>
                </div>
                <div class="icon"><i class="fas fa-user"></i></div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>₹@Model.MonthlyCollection.ToString("N2")</h3>
                    <p>Monthly Collection</p>
                </div>
                <div class="icon"><i class="fas fa-money-bill"></i></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>₹@Model.TotalExpenses.ToString("N2")</h3>
                    <p>Total Expenses</p>
                </div>
                <div class="icon"><i class="fas fa-wallet"></i></div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-primary">
                <div class="inner">
                    <h3>₹@Model.BalanceAmount.ToString("N2")</h3>
                    <p>Balance Amount</p>
                </div>
                <div class="icon"><i class="fas fa-credit-card"></i></div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.PendingPayments</h3>
                        <p>Pending Payments</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                    <a href="/Maintenances" class="small-box-footer text-white">
                        View maintenance <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    @if (User.IsInRole("Admin") && Model.PendingMaintenanceList.Any())
    {
        <div class="card shadow mt-3">
            <div class="card-header bg-warning">
                <h3 class="card-title mb-0">Pending Maintenance Dues</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Flat</th>
                            <th>Month</th>
                            <th>Year</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PendingMaintenanceList)
                        {
                            <tr>
                                <td>@item.FlatNumber</td>
                                <td>@item.Month</td>
                                <td>@item.Year</td>
                                <td>₹@item.Amount.ToString("N2")</td>
                                <td><span class="badge bg-danger">Pending</span></td>
                                <td>
                                    <a asp-controller="Maintenances"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
