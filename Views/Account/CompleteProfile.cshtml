@model ApartmentManagementSystem.Models.CompleteProfileViewModel

@{
    ViewData["Title"] = "Complete Profile";
}

<div class="card shadow p-4 mx-auto" style="max-width: 520px;">
    <h2 class="mb-3">Complete Your Resident Profile</h2>

    <p class="text-muted">
        We need your flat number to show your maintenance payments.
        Logged in as <strong>@Model.Email</strong>
    </p>

    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
        <div class="alert alert-danger">@error.ErrorMessage</div>
    }

    <form asp-action="CompleteProfile" method="post">
        <div class="form-group mb-3">
            <label asp-for="FlatNumber"></label>
            <input asp-for="FlatNumber" class="form-control" placeholder="e.g. 408" required />
            <span asp-validation-for="FlatNumber" class="text-danger"></span>
            <small class="text-muted">Must match the flat number used by admin for your dues.</small>
        </div>

        <div class="form-group mb-3">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Save and Continue</button>
    </form>
</div>
