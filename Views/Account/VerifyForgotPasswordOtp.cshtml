@model ApartmentManagementSystem.Models.VerifyForgotPasswordOtpViewModel

@{
    ViewData["Title"] = "Verify SMS code";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4">
                <h2 class="mb-3 text-center">Enter SMS code</h2>
                <p class="text-muted text-center">
                    We sent a 6-digit code to <strong>@Model.MaskedPhone</strong>.
                    Enter it below to set a new password.
                </p>

                <form asp-action="VerifyForgotPasswordOtp" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label"></label>
                        <input asp-for="OtpCode" class="form-control" autocomplete="one-time-code" maxlength="6" />
                        <span asp-validation-for="OtpCode" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </form>

                <hr />
                <p class="text-center mb-0">
                    <a asp-action="ForgotPassword">Start over</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
