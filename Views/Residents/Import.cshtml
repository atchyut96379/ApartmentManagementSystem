@model ApartmentManagementSystem.Models.ResidentImportResult

@{
    ViewData["Title"] = "Import Residents";
}

<h1>Import Residents from Excel</h1>

@if (ViewBag.IsSystemAdmin == true)
{
    <div class="alert alert-warning">
        Wrong flats (1, 2, 3…) from a bad import?
        <a asp-action="ResetSocietyData" class="btn btn-sm btn-danger ms-2"
           onclick="return confirm('Clear all residents and payments first?');">
            Reset cloud data
        </a>
        then import again (SNO col 1, Flat col 2, Name col 3).
    </div>
}

<p>
    Upload a <strong>.xlsx</strong> file from <strong>Residents &gt; Import from Excel</strong>.
    The importer auto-detects the format from the first row.
</p>

<div class="card mb-3">
    <div class="card-header">Supported formats</div>
    <div class="card-body">
        <h6>1. Standard template (sheet &quot;Residents&quot;)</h6>
        <p class="mb-2">Columns: FlatNumber, ResidentName, Phone (login mobile), Notification email (optional), ResidentType (Owner/Tenant), PropertyOwnerName.</p>

        <h6>2. Society export — SNO + Flat in columns A &amp; B (your layout)</h6>
        <p class="mb-2">
            <strong>Row 1:</strong> SNO (or S.No) | <strong>Flat number</strong> | Name | … (type / contact columns after)<br />
            Data row example: <code>1 | 101 | Rakesh Y | Owner | …</code> — flat is column <strong>2</strong>, not SNO.
        </p>
        <h6 class="mt-3">3. Society export (Name | Flat No first) — alternate layout</h6>
        <p class="mb-2">
            <strong>Row 1:</strong> Name | Flat No | Resident Type (merged over Owner+Tenant) | Owner Contact Number | Tenant Contact number<br />
            <strong>Row 2:</strong> (empty under Name, Flat) | Owner | Tenant | (contact columns may be empty)<br />
            <strong>Data from row 3:</strong> name, flat, mark Owner <em>or</em> Tenant in the type columns
            (<code>Owner</code>, <code>Tenant</code>, <code>X</code>, <code>Yes</code>, <code>1</code>, or a checkmark).
            If type columns are blank, owner contact only implies Owner; tenant contact implies Tenant.
            Multiple phones in one cell (separated by <code>/</code>) use the first number only — that number becomes the login username. Email is optional (for reminders only).
            Tenants may have owner contact without an owner name.
        </p>
        <p class="mb-2 text-muted">
            Combined flats (109+110, 209+210, etc.) are normalized automatically (e.g. flat 110 becomes 109-110).
        </p>
        <p class="mb-0 text-warning">
            <strong>Important:</strong> If you downloaded our template earlier, delete the empty <em>SocietyFormat</em> sheet or put all rows on one sheet.
            The importer picks the sheet with the <strong>most resident rows</strong> (not the template sample sheet with only 2 rows).
            Owner and tenant in the same flat are both imported (duplicate check uses flat + name + type).
        </p>
    </div>
</div>

<p>
    <a asp-action="DownloadTemplate" class="btn btn-outline-secondary">
        <i class="fas fa-download"></i> Download template (both sheets)
    </a>
    <a asp-action="Index" class="btn btn-link">Back to list</a>
</p>

@if (Model == null)
{
    <div class="card shadow">
        <div class="card-body">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label for="file" class="form-label">Excel file (.xlsx)</label>
                    <input type="file" name="file" id="file" class="form-control" accept=".xlsx" required />
                </div>
                <button type="submit" class="btn btn-primary">Import</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Import complete: <strong>@Model.AddedCount</strong> added, <strong>@Model.SkippedCount</strong> skipped
        @if (Model.TotalRowsProcessed > 0)
        {
            <span> (processed @Model.TotalRowsProcessed rows)</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SheetName))
        {
            <br /><span class="small">Worksheet: <strong>@Model.SheetName</strong></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DiagnosticMessage))
        {
            <br /><span class="small text-muted">@Model.DiagnosticMessage</span>
        }
    </div>

    @if (Model.Rows.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Row</th>
                    <th>Name</th>
                    <th>Flat</th>
                    <th>Status</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.RowNumber</td>
                        <td>@row.ResidentName</td>
                        <td>@row.FlatNumber</td>
                        <td>
                            @if (row.Status == "Added")
                            {
                                <span class="badge bg-success">@row.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@row.Status</span>
                            }
                        </td>
                        <td>@row.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.AddedCount > 0)
    {
        <div class="card border-success mb-3">
            <div class="card-header bg-success text-white">Next steps</div>
            <div class="card-body">
                <ol class="mb-0">
                    <li class="mb-2">
                        <strong>Assign committee (do this first)</strong> — system Admin picks President, Secretary, etc.
                        from this same imported list (no duplicate people).
                        <a asp-controller="Committee" asp-action="Index" class="btn btn-sm btn-primary ms-2">Committee setup</a>
                    </li>
                    <li class="mb-2">
                        <strong>Create logins for everyone else</strong> — owners/tenants only (committee are skipped).
                        <a asp-action="BulkCreateLogins" class="btn btn-sm btn-warning text-dark ms-2">Create all logins</a>
                    </li>
                    <li>
                        <strong>Share credentials</strong> — all users sign in at <a asp-controller="Account" asp-action="Login">Login</a>;
                        first login forces a password change.
                    </li>
                </ol>
            </div>
        </div>
    }

    <a asp-action="Import" class="btn btn-primary">Import another file</a>
    <a asp-action="Index" class="btn btn-link">Back to list</a>
}
