@model ApartmentManagementSystem.Models.LoginCredentialsViewModel

@{
    ViewData["Title"] = "Share login credentials";
}

<h1>@(Model.IsPasswordReset ? "New login credentials" : "Resident login created")</h1>

<div class="alert alert-warning">
    <strong>Share these credentials securely</strong> (in person or by phone).
    This page is shown only once. If you lose the password, use <strong>Reset password</strong> on the Residents list.
</div>

<div class="card shadow col-md-6">
    <div class="card-body">
        <p><strong>Resident:</strong> @Model.ResidentName (Flat @Model.FlatNumber)</p>
        <p><strong>Email (username):</strong> <code id="cred-email">@Model.Email</code></p>
        <p><strong>Temporary password:</strong> <code id="cred-password">@Model.TemporaryPassword</code></p>

        <button type="button" class="btn btn-outline-primary btn-sm" onclick="copyCredentials()">
            <i class="fas fa-copy"></i> Copy to clipboard
        </button>
    </div>
</div>

<p class="mt-3 text-muted">
    The resident must log in and choose a new password before using the app.
</p>

<a asp-action="Index" class="btn btn-primary">Back to Residents</a>

@section Scripts {
    <script>
        function copyCredentials() {
            var text = 'Apartment Management login\nEmail: ' +
                document.getElementById('cred-email').innerText +
                '\nTemporary password: ' +
                document.getElementById('cred-password').innerText;
            navigator.clipboard.writeText(text).then(function () {
                alert('Credentials copied to clipboard.');
            });
        }
    </script>
}
