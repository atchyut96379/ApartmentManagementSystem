@model ApartmentManagementSystem.Models.ResidentsIndexViewModel
@using ApartmentManagementSystem.Models
@using ApartmentManagementSystem.Services

@{
    ViewData["Title"] = "Residents List";
}

<h1>Residents List</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (ViewBag.IsSystemAdmin == true)
{
    <div class="alert alert-info mb-3">
        <p class="mb-2">
            You are logged in as system <code>Admin</code>. First <strong>import residents from Excel</strong>
            (or restore your database). Then assign committee roles from that list, or use <strong>New person</strong>
            on the committee page. Committee logins manage residents day to day after setup.
        </p>
        <a asp-action="Import" class="btn btn-success me-1">
            <i class="fas fa-file-excel me-1"></i> Import from Excel
        </a>
        <a asp-action="DownloadTemplate" class="btn btn-outline-secondary me-1">Download template</a>
        <a asp-action="Create" class="btn btn-outline-primary me-1">Add one resident</a>
        <a asp-controller="Committee" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-user-shield me-1"></i> Committee accounts
        </a>
    </div>
}
else if (ViewBag.CanChangeDesignation == true)
{
    <p class="text-muted mb-2">
        As <strong>President</strong> or <strong>Secretary</strong>, you can use <strong>Change role</strong> on any row
        to assign Vice President, Treasurer, etc. (each role only once).
    </p>
}
@if (ViewBag.CanManageResidents == true)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Resident</a>
        <a asp-action="Import" class="btn btn-success">Import from Excel</a>
        <a asp-action="DownloadTemplate" class="btn btn-outline-secondary">Download template</a>
        @if (ViewBag.ResidentsWithoutLogin is int noLogin && noLogin > 0)
        {
            <a asp-action="BulkCreateLogins" class="btn btn-warning text-dark">
                Create all logins (@noLogin)
            </a>
        }
    </p>
}
else if (User.IsInRole("Resident"))
{
    <p class="text-muted">View-only list.</p>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Flat Number</th>
            <th>Resident Name</th>
            <th>Login mobile</th>
            <th>Notification email</th>
            <th>Type</th>
            <th>Property Owner</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Login</th>
            }
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Residents)
        {
            var r = item.Resident;
            <tr>
                <td>@r.FlatNumber</td>
                <td>@r.OwnerName</td>
                <td>@(string.IsNullOrWhiteSpace(r.PhoneNumber) ? "—" : r.PhoneNumber)</td>
                <td>@(string.IsNullOrWhiteSpace(r.Email) ? "—" : r.Email)</td>
                <td>
                    @ResidentMemberHelper.GetMemberTypeLabel(r)
                    @if (r.MemberType == ResidentMemberType.AssociationAdmin && !string.IsNullOrEmpty(r.AssociationDesignation))
                    {
                        <br /><small class="text-muted">@r.AssociationDesignation</small>
                    }
                </td>
                <td>@(r.MemberType == ResidentMemberType.Tenant ? (r.PropertyOwnerName ?? r.OwnerContactNumber ?? "—") : "—")</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @if (item.LoginBroken)
                        {
                            <span class="badge bg-danger">Login needs repair</span>
                        }
                        else if (!item.HasLogin)
                        {
                            <span class="badge bg-secondary">No account</span>
                        }
                        else if (item.MustChangePassword)
                        {
                            <span class="badge bg-warning text-dark">Must change password</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                }
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@r.Id">Details</a>
                    @if (ViewBag.CanManageResidents == true)
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                        @if (!item.HasLogin || item.LoginBroken)
                        {
                            <span> | </span>
                            <a asp-action="CreateLogin" asp-route-id="@r.Id" class="fw-bold">
                                @(item.LoginBroken ? "Repair login" : "Create login")
                            </a>
                        }
                        else
                        {
                            <span> | </span>
                            <form asp-action="ResetPassword" asp-route-id="@r.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Generate a new temporary password for this resident?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Reset password</button>
                            </form>
                        }
                        @if (ViewBag.CanChangeDesignation == true)
                        {
                            <span> | </span>
                            <a asp-action="ChangeDesignation" asp-route-id="@r.Id">Change role</a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
