@model ApartmentManagementSystem.Models.ResidentsIndexViewModel

@{
    ViewData["Title"] = "Residents List";
}

<h1>Residents List</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Resident</a>
    <a asp-action="Import" class="btn btn-success">Import from Excel</a>
    <a asp-action="DownloadTemplate" class="btn btn-outline-secondary">Download template</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Flat Number</th>
            <th>Resident Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Type</th>
            <th>Property Owner</th>
            <th>Login</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Residents)
        {
            var r = item.Resident;
            <tr>
                <td>@r.FlatNumber</td>
                <td>@r.OwnerName</td>
                <td>@r.PhoneNumber</td>
                <td>@r.Email</td>
                <td>@(r.IsOwner ? "Owner" : "Tenant")</td>
                <td>@(r.IsOwner ? "—" : (r.PropertyOwnerName ?? r.OwnerContactNumber ?? "—"))</td>
                <td>
                    @if (!item.HasLogin)
                    {
                        <span class="badge bg-secondary">No account</span>
                    }
                    else if (item.MustChangePassword)
                    {
                        <span class="badge bg-warning text-dark">Must change password</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@r.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@r.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                    @if (!item.HasLogin)
                    {
                        @:|
                        <a asp-action="CreateLogin" asp-route-id="@r.Id" class="fw-bold">Create login</a>
                    }
                    else
                    {
                        @:|
                        <form asp-action="ResetPassword" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Generate a new temporary password for this resident?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Reset password</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
