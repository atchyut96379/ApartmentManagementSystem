@model ApartmentManagementSystem.Models.Resident
@using ApartmentManagementSystem.Models
@using ApartmentManagementSystem.Services

@{
    ViewData["Title"] = "Edit Resident";
    var designations = AssociationDesignations.All;
    var canChangeDesignation = ViewBag.CanChangeDesignation == true;
    var isSystemAdmin = ViewBag.IsSystemAdmin == true;
    var isTenant = Model.MemberType == ResidentMemberType.Tenant;
}

<h1>Edit Resident</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h4>Resident</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="form-group mb-3">
                <label asp-for="FlatNumber" class="control-label"></label>
                <input asp-for="FlatNumber" class="form-control" />
                <span asp-validation-for="FlatNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="OwnerName" class="control-label"></label>
                <input asp-for="OwnerName" class="form-control" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                <div class="form-text">10-digit mobile — login username. Update here if the resident changes their number.</div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="form-text">Optional — for reminder emails only, not for login.</div>
            </div>

            @if (canChangeDesignation)
            {
                <div class="alert alert-info">
                    To assign or change President, Vice President, Secretary, etc., use
                    <a asp-action="ChangeDesignation" asp-route-id="@Model.Id"><strong>Change role</strong></a>
                    on the Residents list (President and Secretary only).
                </div>
            }
            else if (isSystemAdmin)
            {
                <div class="alert alert-info">
                    <strong>Committee roles</strong> (President, Secretary, etc.) are not set on this screen.
                    @if (string.IsNullOrEmpty(Model.UserId))
                    {
                        <span>Use <a asp-action="CreateLogin" asp-route-id="@Model.Id"><strong>Create login</strong></a>
                        and tick <em>Grant committee admin access</em> to pick a role.</span>
                    }
                    else
                    {
                        <span>Use <a asp-controller="Committee" asp-action="Index"><strong>Committee accounts</strong></a>
                        or <a asp-action="ChangeDesignation" asp-route-id="@Model.Id">Change role</a> (if you are President/Secretary).</span>
                    }
                </div>
            }

            <div class="form-group mb-3">
                <label class="control-label">Member type</label>
                @if (canChangeDesignation)
                {
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input member-type" type="radio" asp-for="MemberType" id="typeOwner"
                                   value="@((int)ResidentMemberType.Owner)" />
                            <label class="form-check-label" for="typeOwner">Owner</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input member-type" type="radio" asp-for="MemberType" id="typeTenant"
                                   value="@((int)ResidentMemberType.Tenant)" />
                            <label class="form-check-label" for="typeTenant">Tenant</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input member-type" type="radio" asp-for="MemberType" id="typeAssocAdmin"
                                   value="@((int)ResidentMemberType.AssociationAdmin)" />
                            <label class="form-check-label" for="typeAssocAdmin">Association admin</label>
                        </div>
                    </div>
                }
                else
                {
                    <p class="form-control-plaintext mb-0">
                        @ResidentMemberHelper.GetMemberTypeLabel(Model)
                        @if (Model.MemberType == ResidentMemberType.AssociationAdmin && !string.IsNullOrEmpty(Model.AssociationDesignation))
                        {
                            <span class="text-muted">(@Model.AssociationDesignation)</span>
                        }
                    </p>
                    <input type="hidden" asp-for="MemberType" id="memberTypeValue" />
                    <input type="hidden" asp-for="AssociationDesignation" />
                }
            </div>

            @if (canChangeDesignation)
            {
                <div class="form-group mb-3" id="designationGroup">
                    <label asp-for="AssociationDesignation" class="control-label"></label>
                    <select asp-for="AssociationDesignation" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var d in designations)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                    <span asp-validation-for="AssociationDesignation" class="text-danger"></span>
                </div>
            }

            <div class="form-group mb-3" id="tenantFieldsGroup" style="@(isTenant ? "" : "display:none")">
                <p class="text-muted small">Shown only for <strong>Tenant</strong> — property owner contact for the flat.</p>
                <label asp-for="PropertyOwnerName" class="control-label"></label>
                <input asp-for="PropertyOwnerName" class="form-control" />
                <label asp-for="OwnerContactNumber" class="control-label mt-2"></label>
                <input asp-for="OwnerContactNumber" class="form-control" />
            </div>

            @if (!string.IsNullOrEmpty(Model.UserId))
            {
                <p class="text-muted">
                    Login exists. Use <strong>Reset password</strong> on the residents list to issue a new temporary password.
                </p>
            }

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const assocAdmin = '@((int)ResidentMemberType.AssociationAdmin)';
        const tenant = '@((int)ResidentMemberType.Tenant)';

        function selectedMemberType() {
            const checked = document.querySelector('.member-type:checked');
            if (checked) {
                return checked.value;
            }
            const hidden = document.getElementById('memberTypeValue');
            return hidden ? hidden.value : '@((int)ResidentMemberType.Owner)';
        }

        function toggleMemberFields() {
            const type = selectedMemberType();
            const designationGroup = document.getElementById('designationGroup');
            if (designationGroup) {
                designationGroup.style.display = type === assocAdmin ? 'block' : 'none';
            }
            const tenantGroup = document.getElementById('tenantFieldsGroup');
            if (tenantGroup) {
                tenantGroup.style.display = type === tenant ? 'block' : 'none';
            }
        }

        document.querySelectorAll('.member-type').forEach(el =>
            el.addEventListener('change', toggleMemberFields));
        toggleMemberFields();
    </script>
}
