@model ApartmentManagementSystem.Models.CreateResidentViewModel
@using ApartmentManagementSystem.Models

@{
    ViewData["Title"] = "Create Resident";
    var hasCommitteeSlots = Model.AvailableDesignations.Count > 0;
}

<h1>Add Resident</h1>

<h4>Resident</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FlatNumber" class="control-label"></label>
                <input asp-for="FlatNumber" class="form-control" />
                <span asp-validation-for="FlatNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OwnerName" class="control-label"></label>
                <input asp-for="OwnerName" class="form-control" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                <div class="form-text">10-digit mobile — used as login username when you create an account.</div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="form-text">Optional — for payment reminder emails only, not for login.</div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Member type</label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input member-type" type="radio" asp-for="MemberType" id="typeOwner"
                               value="@((int)ResidentMemberType.Owner)" />
                        <label class="form-check-label" for="typeOwner">Owner</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input member-type" type="radio" asp-for="MemberType" id="typeTenant"
                               value="@((int)ResidentMemberType.Tenant)" />
                        <label class="form-check-label" for="typeTenant">Tenant</label>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3" id="tenantFieldsGroup" style="display:none">
                <label asp-for="PropertyOwnerName" class="control-label"></label>
                <input asp-for="PropertyOwnerName" class="form-control" />
                <label asp-for="OwnerContactNumber" class="control-label mt-2"></label>
                <input asp-for="OwnerContactNumber" class="form-control" />
                <small class="text-muted">Tenants need property owner name or owner contact number.</small>
            </div>

            <div class="card border-success mb-3" id="loginOptionsCard">
                <div class="card-body">
                    <div class="form-check">
                        <input asp-for="CreateLoginAccount" class="form-check-input" id="createLogin" />
                        <label class="form-check-label" for="createLogin">
                            <strong>Create login account</strong>
                        </label>
                    </div>
                    <p class="text-muted small mb-2 mt-2">
                        Default password: <strong>@(ViewBag.DefaultPasswordFormat ?? "first 4 letters of apartment name + flat number")</strong>
                        (shown on the next screen). The resident must change it on first login.
                    </p>

                    <div id="committeeOnCreateGroup" class="border-top pt-3 @(Model.CreateLoginAccount ? "" : "d-none")">
                        <div class="form-check">
                            <input asp-for="GrantCommitteeAdminAccess" class="form-check-input" id="grantCommittee" />
                            <label class="form-check-label" for="grantCommittee">
                                <strong>@Html.DisplayNameFor(m => m.GrantCommitteeAdminAccess)</strong>
                            </label>
                        </div>
                        <div id="committeeRoleGroup" class="mt-2 @(Model.GrantCommitteeAdminAccess ? "" : "d-none")">
                            <label asp-for="AssociationDesignation" class="control-label"></label>
                            @if (hasCommitteeSlots)
                            {
                                <select asp-for="AssociationDesignation" class="form-select">
                                    <option value="">— Select committee role —</option>
                                    @foreach (var d in Model.AvailableDesignations)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <p class="text-danger small mb-0">All five committee roles are assigned.</p>
                            }
                            <span asp-validation-for="AssociationDesignation" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const tenant = '@((int)ResidentMemberType.Tenant)';

        function selectedMemberType() {
            const checked = document.querySelector('.member-type:checked');
            return checked ? checked.value : '@((int)ResidentMemberType.Owner)';
        }

        function toggleMemberFields() {
            const type = selectedMemberType();
            document.getElementById('tenantFieldsGroup').style.display =
                type === tenant ? 'block' : 'none';
        }

        document.querySelectorAll('.member-type').forEach(el =>
            el.addEventListener('change', toggleMemberFields));
        toggleMemberFields();

        const createLogin = document.getElementById('createLogin');
        const grantCommittee = document.getElementById('grantCommittee');
        const loginOptions = document.getElementById('committeeOnCreateGroup');
        const roleGroup = document.getElementById('committeeRoleGroup');

        function toggleLoginOptions() {
            if (loginOptions) {
                loginOptions.classList.toggle('d-none', !createLogin?.checked);
            }
            if (!createLogin?.checked && grantCommittee) {
                grantCommittee.checked = false;
            }
            toggleCommitteeRole();
        }

        function toggleCommitteeRole() {
            if (roleGroup && grantCommittee) {
                roleGroup.classList.toggle(
                    'd-none',
                    !createLogin?.checked || !grantCommittee.checked);
            }
        }

        createLogin?.addEventListener('change', toggleLoginOptions);
        grantCommittee?.addEventListener('change', toggleCommitteeRole);
        toggleLoginOptions();
    </script>
}
