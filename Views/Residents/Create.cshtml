@model ApartmentManagementSystem.Models.Resident

@{
    ViewData["Title"] = "Create Resident";
}

<h1>Add Resident</h1>

<h4>Resident</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FlatNumber" class="control-label">Flat Number</label>
                <input asp-for="FlatNumber" class="form-control" />
                <span asp-validation-for="FlatNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OwnerName" class="control-label">Resident Name</label>
                <input asp-for="OwnerName" class="form-control" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label">Phone</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Type</label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsOwner" id="typeOwner" value="true" checked="@(Model?.IsOwner != false)" />
                        <label class="form-check-label" for="typeOwner">Owner</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsOwner" id="typeTenant" value="false" checked="@(Model?.IsOwner == false)" />
                        <label class="form-check-label" for="typeTenant">Tenant</label>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3" id="tenantFieldsGroup">
                <label asp-for="PropertyOwnerName" class="control-label">Property Owner Name</label>
                <input asp-for="PropertyOwnerName" class="form-control" />
                <span asp-validation-for="PropertyOwnerName" class="text-danger"></span>
                <label asp-for="OwnerContactNumber" class="control-label mt-2">Owner Contact Number</label>
                <input asp-for="OwnerContactNumber" class="form-control" />
                <span asp-validation-for="OwnerContactNumber" class="text-danger"></span>
                <small class="text-muted">Tenants need property owner name or owner contact number.</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePropertyOwner() {
            var isTenant = document.getElementById('typeTenant').checked;
            document.getElementById('tenantFieldsGroup').style.display = isTenant ? 'block' : 'none';
        }
        document.getElementById('typeOwner').addEventListener('change', togglePropertyOwner);
        document.getElementById('typeTenant').addEventListener('change', togglePropertyOwner);
        togglePropertyOwner();
    </script>
}
