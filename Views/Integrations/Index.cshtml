@model ApartmentManagementSystem.Models.IntegrationsConfigureViewModel

@{
    ViewData["Title"] = "Integrations";
    var status = Model.Status;
}

<h2 class="mb-3">Integrations</h2>

<div class="card border-success mb-3">
    <div class="card-header bg-success text-white py-2">Razorpay</div>
    <div class="card-body small py-2">
        <p class="mb-1">Test keys from <a href="https://dashboard.razorpay.com" target="_blank" rel="noopener">Razorpay</a> → paste below → Save.</p>
        <p class="mb-1">Webhook (optional): <code>@(status.AppUrl.TrimEnd('/'))/api/razorpay/webhook</code></p>
        <p class="mb-0">
            Mode:
            @if (status.RazorpayReady)
            {
                <span class="badge bg-success">Razorpay</span>
            }
            else
            {
                <span class="badge bg-secondary">Simulation</span>
            }
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.ConfigFileExists)
{
    <div class="alert alert-warning py-2 small">No saved settings — save once below.</div>
}

<form asp-action="Save" method="post" class="card shadow mb-4">
    @Html.AntiForgeryToken()
    <div class="card-header bg-primary text-white">Configure &amp; save</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <h5 class="border-bottom pb-2">Email (Gmail / SMTP)</h5>
                <div class="form-check mb-2">
                    <input asp-for="EnableEmail" class="form-check-input" />
                    <label asp-for="EnableEmail" class="form-check-label"></label>
                </div>
                <div class="mb-2">
                    <label asp-for="SmtpHost" class="form-label">SMTP host</label>
                    <input asp-for="SmtpHost" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-6 mb-2">
                        <label asp-for="SmtpPort" class="form-label">Port</label>
                        <input asp-for="SmtpPort" class="form-control" type="number" />
                    </div>
                    <div class="col-6 mb-2 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="SmtpUseSsl" class="form-check-input" />
                            <label asp-for="SmtpUseSsl" class="form-check-label">Use SSL/TLS</label>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <label asp-for="SmtpUser" class="form-label">SMTP user (Gmail address)</label>
                    <input asp-for="SmtpUser" class="form-control" autocomplete="username" />
                </div>
                <div class="mb-2">
                    <label asp-for="SmtpPassword" class="form-label"></label>
                    <input asp-for="SmtpPassword" class="form-control" type="password" autocomplete="new-password"
                           placeholder="@(Model.PasswordOnFile ? "Leave blank to keep saved password" : "Gmail app password")" />
                </div>
                <div class="mb-2">
                    <label asp-for="FromEmail" class="form-label">From email</label>
                    <input asp-for="FromEmail" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="FromName" class="form-label">From name</label>
                    <input asp-for="FromName" class="form-control" />
                </div>
                <span class="badge @(status.EmailReady ? "bg-success" : "bg-warning text-dark")">
                    Email: @(status.EmailReady ? "Ready" : "Not configured")
                </span>
            </div>

            <div class="col-md-6">
                <h5 class="border-bottom pb-2">SMS</h5>
                <div class="form-check mb-2">
                    <input asp-for="EnableSms" class="form-check-input" />
                    <label asp-for="EnableSms" class="form-check-label"></label>
                </div>
                <div class="mb-2">
                    <label asp-for="SmsProvider" class="form-label">Provider</label>
                    <select asp-for="SmsProvider" class="form-select">
                        <option value="Msg91">Msg91 (India — live SMS)</option>
                        <option value="Simulation">Simulation (test — no real SMS)</option>
                        <option value="Twilio">Twilio</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91AuthKey" class="form-label">MSG91 Auth Key</label>
                    <input asp-for="Msg91AuthKey" class="form-control" type="password"
                           placeholder="@(Model.Msg91KeyOnFile ? "Leave blank to keep saved key" : "")" />
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91SenderId" class="form-label">MSG91 Sender ID (6 chars)</label>
                    <input asp-for="Msg91SenderId" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91FlowId" class="form-label">MSG91 Flow / Template ID (DLT)</label>
                    <input asp-for="Msg91FlowId" class="form-control" placeholder="From SMS → Templates → copy Template ID" />
                    <div class="form-text small">
                        India: create template with variables ##name##, ##month##, ##link## (DLT approved), then paste Flow ID here or Azure <code>Notification__Msg91FlowId</code>.
                    </div>
                </div>
                <hr />
                <div class="mb-2">
                    <label asp-for="TwilioAccountSid" class="form-label">Twilio Account SID</label>
                    <input asp-for="TwilioAccountSid" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="TwilioAuthToken" class="form-label">Twilio Auth Token</label>
                    <input asp-for="TwilioAuthToken" class="form-control" type="password"
                           placeholder="@(Model.TwilioTokenOnFile ? "Leave blank to keep saved token" : "")" />
                </div>
                <div class="mb-2">
                    <label asp-for="TwilioFromNumber" class="form-label">Twilio From number</label>
                    <input asp-for="TwilioFromNumber" class="form-control" placeholder="+1..." />
                </div>
                <span class="badge @(status.SmsReady ? "bg-success" : "bg-warning text-dark")">
                    SMS: @(status.SmsReady ? "Ready" : "Not configured")
                </span>
            </div>

            <div class="col-md-6">
                <h5 class="border-bottom pb-2">WhatsApp reminders</h5>
                <div class="form-check mb-2">
                    <input asp-for="EnableWhatsAppReminders" class="form-check-input" />
                    <label asp-for="EnableWhatsAppReminders" class="form-check-label"></label>
                </div>
                <div class="mb-2">
                    <label asp-for="WhatsAppProvider" class="form-label">Provider</label>
                    <select asp-for="WhatsAppProvider" class="form-select">
                        <option value="ClickToChat">Click-to-Chat (recommended — opens association WhatsApp)</option>
                        <option value="Msg91">MSG91 (for automatic API when ready)</option>
                        <option value="Simulation">Simulation (test only)</option>
                    </select>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="Msg91WhatsAppApiEnabled" class="form-check-input" />
                    <label asp-for="Msg91WhatsAppApiEnabled" class="form-check-label"></label>
                    <div class="form-text small">
                        Leave off while MSG91 Send WhatsApp shows &quot;No Template Found&quot;. Reminders use green WhatsApp links on the collection dashboard instead.
                    </div>
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91WhatsAppIntegratedNumber" class="form-label"></label>
                    <input asp-for="Msg91WhatsAppIntegratedNumber" class="form-control" placeholder="9198xxxxxxxx" />
                    <div class="form-text small">MSG91 → WhatsApp → your connected business number.</div>
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91WhatsAppTemplateName" class="form-label"></label>
                    <input asp-for="Msg91WhatsAppTemplateName" class="form-control" placeholder="approved_template_name" />
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91WhatsAppTemplateLanguage" class="form-label">Template language code</label>
                    <input asp-for="Msg91WhatsAppTemplateLanguage" class="form-control" placeholder="en" />
                </div>
                <div class="mb-2">
                    <label asp-for="Msg91WhatsAppTemplateNamespace" class="form-label"></label>
                    <input asp-for="Msg91WhatsAppTemplateNamespace" class="form-control" placeholder="Only if MSG91 template details show namespace" />
                </div>
                <p class="small text-muted mb-2">@status.WhatsAppStatus</p>
                <span class="badge @(status.WhatsAppReady ? "bg-success" : "bg-warning text-dark")">
                    WhatsApp: @(status.WhatsAppReady ? "Ready" : "Not configured")
                </span>
            </div>

            <div class="col-12">
                <h5 class="border-bottom pb-2">Razorpay payment gateway</h5>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label asp-for="PaymentProvider" class="form-label">Provider</label>
                        <select asp-for="PaymentProvider" class="form-select">
                            <option value="Simulation">Simulation (testing)</option>
                            <option value="Razorpay">Razorpay (live)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="RazorpayKeyId" class="form-label">Key ID</label>
                        <input asp-for="RazorpayKeyId" class="form-control" placeholder="rzp_test_..." />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="RazorpayKeySecret" class="form-label">Key secret</label>
                        <input asp-for="RazorpayKeySecret" class="form-control" type="password"
                               placeholder="@(Model.RazorpaySecretOnFile ? "Leave blank to keep" : "")" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="RazorpayWebhookSecret" class="form-label">Webhook secret</label>
                        <input asp-for="RazorpayWebhookSecret" class="form-control" type="password" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AppUrl" class="form-label">Public app URL (for email links)</label>
                        <input asp-for="AppUrl" class="form-control" placeholder="https://localhost:7119" />
                    </div>
                </div>
                <p class="small text-muted mt-2 mb-1">Webhook: <code class="text-break">@status.WebhookUrl</code></p>
                <span class="badge @(status.RazorpayReady ? "bg-success" : "bg-warning text-dark") me-1">
                    Razorpay: @(status.RazorpayReady ? "Live" : "Not ready")
                </span>
                <span class="badge @(status.WebhookReady ? "bg-success" : "bg-secondary")">
                    Webhook secret @(status.WebhookReady ? "set" : "not set")
                </span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg mt-3">
            <i class="fas fa-save"></i> Save settings
        </button>
    </div>
</form>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h5>Test email</h5>
                <form asp-action="TestEmail" method="post">
                    @Html.AntiForgeryToken()
                    <input type="email" name="testEmail" class="form-control mb-2" placeholder="your@email.com" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary" @(status.EmailReady ? "" : "disabled")>
                        Send test email
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h5>Test SMS</h5>
                <form asp-action="TestSms" method="post">
                    @Html.AntiForgeryToken()
                    <input type="text" name="testPhone" class="form-control mb-2" placeholder="10-digit mobile" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary" @(status.SmsReady ? "" : "disabled")>
                        Send test SMS
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h5>Test WhatsApp (MSG91 API)</h5>
                <form asp-action="TestWhatsApp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="text" name="testPhone" class="form-control mb-2" placeholder="10-digit mobile to receive test" required />
                    <button type="submit" class="btn btn-sm btn-outline-success" @(status.WhatsAppApiReady ? "" : "disabled")>
                        Send test WhatsApp
                    </button>
                </form>
                <p class="small text-muted mb-0 mt-2">Requires provider <strong>Msg91</strong>, approved template, and number 919063920689. Then check MSG91 → WhatsApp → Logs.</p>
            </div>
        </div>
    </div>
</div>

<p class="small text-muted mt-3 mb-0">Gmail: app password. MSG91: auth key + sender ID. WhatsApp: template name must match MSG91 exactly.</p>
