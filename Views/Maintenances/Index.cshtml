@model IEnumerable<ApartmentManagementSystem.Models.Maintenance>

@{
    ViewData["Title"] = "Maintenance List";
    var flatsWithout = ViewBag.FlatsWithoutMaintenance as List<string> ?? new List<string>();
    var defaultAmount = ViewBag.DefaultAmount ?? 1200m;
}

<h1>Maintenance List</h1>

<div class="alert alert-info">
    <strong>Automatic billing:</strong> Every resident flat receives
    <strong>₹@defaultAmount.ToString("N0")</strong> maintenance for the current month automatically.
    Payment records are generated by the system. As an admin you can view records here but cannot create, edit, or delete maintenance payments.
</div>

@if (flatsWithout.Any())
{
    <div class="alert alert-warning">
        Missing maintenance for flat(s): @string.Join(", ", flatsWithout).
        Refresh this page to auto-generate, or add a resident record first.
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Flat Number</th>
            <th>Amount</th>
            <th>Month</th>
            <th>Year</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Remarks</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FlatNumber</td>
                <td>₹@item.Amount.ToString("N2")</td>
                <td>@item.Month</td>
                <td>@item.Year</td>
                <td>
                    @if (item.PaymentStatus)
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pending</span>
                    }
                </td>
                <td>@(item.PaymentDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
