@model IEnumerable<ApartmentManagementSystem.Models.Maintenance>

@{
    ViewData["Title"] = "Maintenance List";
    var flatsWithout = ViewBag.FlatsWithoutMaintenance as List<string> ?? new List<string>();
    var defaultAmount = ViewBag.DefaultAmount ?? 1200m;
}

<h1>Maintenance List</h1>

@if (User.IsInRole("Admin"))
{
    <p class="small text-muted mb-2">Auto ₹@defaultAmount.ToString("N0")/month per flat — view only here.</p>
}
else
{
    <p class="small text-muted mb-2">View only — pay in <a href="/ResidentPayments/MyPayments">My payments</a>.</p>
}

@if (flatsWithout.Any())
{
    <div class="alert alert-warning py-2 small mb-2">
        No billing yet: @string.Join(", ", flatsWithout). Refresh or add resident.
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Flat Number</th>
            <th>Amount</th>
            <th>Month</th>
            <th>Year</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Remarks</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FlatNumber</td>
                <td>₹@item.Amount.ToString("N2")</td>
                <td>@item.Month</td>
                <td>@item.Year</td>
                <td>
                    @if (item.PaymentStatus)
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pending</span>
                    }
                </td>
                <td>@(item.PaymentDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
