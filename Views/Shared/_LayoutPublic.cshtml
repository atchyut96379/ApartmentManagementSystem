@model ApartmentManagementSystem.Models.PublicSiteViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Model.ApartmentName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Public">@Model.ApartmentName</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Account" asp-action="Login">Resident login</a>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="container pb-4 text-muted small border-top pt-3">
        <a asp-action="Public">About</a> ·
        <a asp-action="Privacy">Privacy</a> ·
        <a asp-action="Terms">Terms</a> ·
        <a asp-action="Refund">Refund policy</a> ·
        <a asp-action="Contact">Contact</a>
    </footer>
</body>
</html>
