@model ApartmentManagementSystem.Models.ResidentPaymentsViewModel

@{
    var pendingItems = Model.Payments.Where(p => !p.PaymentStatus).ToList();
    var paidItems = Model.Payments.Where(p => p.PaymentStatus).ToList();
}

<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">
            My Maintenance Payments
            @if (!string.IsNullOrEmpty(Model.FlatNumber))
            {
                <small class="ms-2">(Flat @Model.FlatNumber)</small>
            }
        </h3>
    </div>

    <div class="card-body">
        @if (!Model.HasResidentProfile)
        {
            <div class="alert alert-warning py-2 mb-0 small">
                <a asp-controller="Account" asp-action="CompleteProfile" class="alert-link fw-bold">Set your flat</a>
                to see dues.
            </div>
        }
        else if (Model.TotalAssignedCount == 0)
        {
            <div class="alert alert-warning py-2 mb-0 small">
                No dues for flat <strong>@Model.FlatNumber</strong> yet — refresh shortly.
            </div>
        }
        else if (Model.PendingCount == 0)
        {
            <div class="alert alert-success py-2 small">
                All paid (@Model.TotalAssignedCount record(s)).
            </div>

            @if (paidItems.Any())
            {
                @await Html.PartialAsync("_ResidentPaymentTableBody", (paidItems, Model, false))
            }
        }
        else
        {
            <div class="alert alert-info py-2 small">
                <strong>@Model.PendingCount</strong> pending — use <strong>Pay now</strong>.
            </div>

            @await Html.PartialAsync("_ResidentPaymentTableBody", (pendingItems, Model, true))

            @if (!Model.PendingOnly && paidItems.Any())
            {
                <h5 class="mt-4 mb-2">Payment History</h5>
                @await Html.PartialAsync("_ResidentPaymentTableBody", (paidItems, Model, false))
            }
        }
    </div>
</div>
