<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Apartment Management</title>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d6a4f 100%);
            min-height: 100vh;
        }
        .login-page-brand {
            color: #fff;
            text-align: center;
            padding: 2rem 1rem 0;
        }
    </style>
</head>
<body>
    <div class="login-page-brand">
        <h1 class="h3 mb-0">Apartment Management</h1>
    </div>
    <main>
        @RenderBody()
    </main>
    <footer class="text-center text-white-50 small py-3">
        <a class="text-white" asp-controller="Home" asp-action="Public">About</a>
        · <a class="text-white" asp-controller="Home" asp-action="Privacy">Privacy</a>
        · <a class="text-white" asp-controller="Home" asp-action="Terms">Terms</a>
        · <a class="text-white" asp-controller="Home" asp-action="Refund">Refund</a>
        · <a class="text-white" asp-controller="Home" asp-action="Contact">Contact</a>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
