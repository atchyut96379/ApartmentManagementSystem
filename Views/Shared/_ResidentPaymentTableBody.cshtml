@using ApartmentManagementSystem.Models
@model (List<Maintenance> Items, ResidentPaymentsViewModel Parent, bool ShowPayNow)

<table class="table table-bordered table-hover mb-0">
    <thead class="table-dark">
        <tr>
            <th>Flat</th>
            <th>Month</th>
            <th>Year</th>
            <th>Amount</th>
            <th>Status</th>
            @if (Model.ShowPayNow)
            {
                <th>Pay</th>
            }
            @if (Model.Parent.ShowReceiptColumns && !Model.ShowPayNow)
            {
                <th>Transaction ID</th>
                <th>Receipt</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.FlatNumber</td>
                <td>@item.Month</td>
                <td>@item.Year</td>
                <td>₹@item.Amount.ToString("N2")</td>
                <td>
                    @if (item.PaymentStatus)
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pending</span>
                    }
                </td>
                @if (Model.ShowPayNow)
                {
                    <td>
                        <a asp-controller="ResidentPayments"
                           asp-action="Checkout"
                           asp-route-id="@item.Id"
                           asp-route-returnUrl="@Model.Parent.ReturnUrl"
                           class="btn btn-primary btn-sm">
                            <i class="fas fa-credit-card me-1"></i> Pay Now
                        </a>
                    </td>
                }
                @if (Model.Parent.ShowReceiptColumns && !Model.ShowPayNow)
                {
                    <td>
                        @if (!string.IsNullOrEmpty(item.TransactionId))
                        {
                            <code class="small">@item.TransactionId</code>
                        }
                        else
                        {
                            @:—
                        }
                    </td>
                    <td>
                        @if (item.PaymentStatus && !string.IsNullOrEmpty(item.TransactionId))
                        {
                            <a asp-controller="ResidentPayments" asp-action="Receipt" asp-route-id="@item.Id">View</a>
                            <span class="text-muted">|</span>
                            <a asp-controller="ResidentPayments" asp-action="DownloadReceipt" asp-route-id="@item.Id">PDF</a>
                        }
                        else
                        {
                            @:—
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
