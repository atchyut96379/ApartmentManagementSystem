@using Microsoft.AspNetCore.Hosting
@model ErrorViewModel
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<p class="text-danger">An error occurred while processing your request.</p>

@if (Model.ShowUserMessage)
{
    <div class="alert alert-warning">@Model.UserMessage</div>
}

@if (Model.ShowRequestId)
{
    <p class="small text-muted mb-0">
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (HostEnvironment.IsDevelopment())
{
    <hr />
    <p class="small text-muted">
        Development mode shows more detail in server logs. On Azure, check <strong>Log stream</strong> for this Request ID.
    </p>
}
